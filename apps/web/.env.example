# Copie para .env e preencha para usar o DataSource do Supabase.
# Sem essas variáveis, o app roda em modo demo (DataSource mock).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# WhatsApp do suporte da plataforma, só dígitos com DDI (ex.: 5531999999999). Vazio = botão avisa que não está configurado.
VITE_SUPPORT_WHATSAPP=
